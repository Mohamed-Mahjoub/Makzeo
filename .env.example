# Copier ce fichier en .env puis adapter les valeurs (ne jamais committer .env)
POSTGRES_PASSWORD=postgres
# Clé HMAC partagée par tous les services (>= 32 caractères). Générer par ex. : openssl rand -base64 48
JWT_SECRET=change-me-please-with-a-long-random-secret-0123456789
ADMIN_PASSWORD=Admin@12345
CORS_ALLOWED_ORIGINS=http://localhost:4200
