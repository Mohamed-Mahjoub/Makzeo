# Copier ce fichier en .env puis remplacer TOUTES les valeurs A_DEFINIR (ne jamais committer .env).
# Les services refusent de démarrer si une valeur manque ou si JWT_SECRET fait moins de 32 caractères.

# Mot de passe du superutilisateur PostgreSQL (utilisé aussi par les 4 services avec base)
POSTGRES_PASSWORD=A_DEFINIR

# Clé HMAC partagée par les 5 services, au moins 32 caractères aléatoires. Générer par exemple :
#   PowerShell : $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
#   Linux/macOS : openssl rand -base64 48
JWT_SECRET=A_DEFINIR

# Mot de passe du compte "admin" créé au premier démarrage (base vide), 8 caractères minimum
ADMIN_PASSWORD=A_DEFINIR

# Adresses du navigateur autorisées : passerelle Docker (8080) et Angular en développement (4200)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:4200
