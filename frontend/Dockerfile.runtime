# ---------------------------------------------------------------------------
# Image construite à partir de l'interface déjà compilée par le pipeline (build once, deploy many).
# Contexte de build : un dossier contenant browser/, nginx.conf et security-headers.conf.
# ---------------------------------------------------------------------------
FROM nginxinc/nginx-unprivileged:1.27-alpine
ARG VERSION=dev
LABEL org.opencontainers.image.title="makzeo-frontend" \
      org.opencontainers.image.description="Makzeo - interface web" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.vendor="Makzeo"
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY browser/ /usr/share/nginx/html/
EXPOSE 8080
