# =============================================================================
# Plan d'adressage du laboratoire VMware (réseau NAT VMnet8).
# Adapter le préfixe 192.168.80 au sous-réseau affiché dans "Virtual Network Editor".
# Ce fichier est lu par tous les scripts de infra/.
# =============================================================================
MASTER_IP=192.168.80.10
WORKER1_IP=192.168.80.11
WORKER2_IP=192.168.80.12
DEVOPS_IP=${MASTER_IP}   # outils DevOps (Docker) hébergés sur le master

# Kubernetes
K8S_VERSION=v1.35
POD_CIDR=10.244.0.0/16
CALICO_VERSION=v3.33.0
LOCAL_PATH_VERSION=v0.0.35

# Registre Docker hébergé par Nexus (HTTP, réseau privé du laboratoire)
NEXUS_REGISTRY=${DEVOPS_IP}:8083

# Noms d'hôtes publics (nip.io résout <nom>.<IP>.nip.io vers <IP>)
APP_HOST=makzeo.${WORKER1_IP}.nip.io
GRAFANA_HOST=grafana.${WORKER1_IP}.nip.io
PROMETHEUS_HOST=prometheus.${WORKER1_IP}.nip.io
