<?xml version="1.0" encoding="UTF-8"?>
<!--
  Paramètres Maven du pipeline : toutes les dépendances passent par Nexus (proxy de Maven Central)
  et les artefacts sont publiés dans maven-snapshots / maven-releases.
  Identifiants fournis par variables d'environnement : NEXUS_URL, NEXUS_CI_USER, NEXUS_CI_PASSWORD.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
    <mirrors>
        <mirror>
            <id>nexus</id>
            <name>Nexus - maven-public</name>
            <mirrorOf>*</mirrorOf>
            <url>${env.NEXUS_URL}/repository/maven-public/</url>
        </mirror>
    </mirrors>
    <servers>
        <server>
            <id>nexus</id>
            <username>${env.NEXUS_CI_USER}</username>
            <password>${env.NEXUS_CI_PASSWORD}</password>
        </server>
        <server>
            <id>nexus-releases</id>
            <username>${env.NEXUS_CI_USER}</username>
            <password>${env.NEXUS_CI_PASSWORD}</password>
        </server>
        <server>
            <id>nexus-snapshots</id>
            <username>${env.NEXUS_CI_USER}</username>
            <password>${env.NEXUS_CI_PASSWORD}</password>
        </server>
    </servers>
</settings>
